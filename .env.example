FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///atelier_home.db
STORE_NAME=Atelier Home
STORE_CURRENCY=USD
WHATSAPP_NUMBER=447352794862
SUPPORT_EMAIL=hello@example.com
# Create the first administrator interactively with: flask --app run.py create-admin
# Bank transfer instructions are configurable from Admin > Settings; no real bank details are included.
# WhatsApp Cloud API (optional; not live until credentials/webhooks are configured):
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
# Card gateway (optional; never enabled by default):
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# New-order email notification (SMTP). Set these in your private .env file.
ORDER_NOTIFY_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=use-a-provider-app-password-not-your-normal-login-password
SMTP_FROM=Atelier Home <you@example.com>

# Automated WhatsApp order notification via Meta WhatsApp Cloud API.
# Create/approve a Utility template with one BODY placeholder {{1}}, e.g.
# "New order notification: {{1}}". Template language must match below.
ORDER_NOTIFY_WHATSAPP=15551234567
WHATSAPP_ORDER_TEMPLATE=atelier_new_order
WHATSAPP_TEMPLATE_LANGUAGE=en_US
