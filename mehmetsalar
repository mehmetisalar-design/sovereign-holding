    <!-- Interactive JS Scripts -->
    <script type="text/javascript">
        // Cursor dot and ring logic
        const dot = document.getElementById('cursorDot');
        const ring = document.getElementById('cursorRing');

        window.addEventListener('mousemove', (e) => {
            dot.style.transform = `translate(${e.clientX}px, ${e.clientY}px) translate(-50%, -50%)`;
            ring.style.transform = `translate(${e.clientX}px, ${e.clientY}px) translate(-50%, -50%)`;
        });

        document.querySelectorAll('a, button, select, .bio-box, .global-card, .holding-item, .gallery-img-box').forEach(elem => {
            elem.addEventListener('mouseenter', () => {
                ring.style.width = '50px';
                ring.style.height = '50px';
                ring.style.borderColor = '#b89752';
            });
            elem.addEventListener('mouseleave', () => {
                ring.style.width = '32px';
                ring.style.height = '32px';
            });
        });

        // Dropdown toggle logic
        function toggleLangMenu() {
            const wrapper = document.getElementById('langDropdownWrapper');
            wrapper.classList.toggle('active');
        }

        document.addEventListener('click', function(e) {
            const wrapper = document.getElementById('langDropdownWrapper');
            if (!wrapper.contains(e.target)) {
                wrapper.classList.remove('active');
            }
        });

        function googleTranslateElementInit() {
            new google.translate.TranslateElement({
                pageLanguage: 'en',
                includedLanguages: 'en,ur,tr,ar,es,fr,de,zh-CN,ru,hi',
                autoDisplay: false
            }, 'google_translate_element');
        }

        function selectLanguage(langCode, langName) {
            document.getElementById('langDropdownWrapper').classList.remove('active');

            var domain = window.location.hostname;
            document.cookie = "googtrans=/en/" + langCode + "; path=/; domain=" + domain;
            document.cookie = "googtrans=/en/" + langCode + "; path=/;";

            var elementSelect = document.querySelector('.goog-te-combo');
            if (elementSelect) {
                elementSelect.value = langCode;
                elementSelect.dispatchEvent(new Event('change'));
            } else {
                window.location.reload();
            }
        }
    </script>
    <script type="text/javascript" src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
