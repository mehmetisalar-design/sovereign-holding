    <style>
        :root {
            --bg-main: #ffffff;
            --bg-card: #faf9f6;
            --bg-accent: #f2efe9;
            --text-main: #111111;
            --text-muted: #555555;
            --gold-accent: #b89752;
            --border-color: #e2ded7;
            --font-serif: 'Cinzel', serif;
            --font-sans: 'Outfit', sans-serif;
            --transition-smooth: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            cursor: none !important;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            font-family: var(--font-sans);
            line-height: 1.8;
            overflow-x: hidden;
            top: 0 !important;
        }

        /* CUSTOM DOT-CIRCLE CURSOR */
        .custom-cursor-dot {
            position: fixed;
            top: 0;
            left: 0;
            width: 6px;
            height: 6px;
            background-color: var(--gold-accent);
            border-radius: 50%;
            pointer-events: none;
            z-index: 99999;
            transform: translate(-50%, -50%);
            transition: transform 0.05s ease;
        }

        .custom-cursor-ring {
            position: fixed;
            top: 0;
            left: 0;
            width: 32px;
            height: 32px;
            border: 1px solid rgba(184, 151, 82, 0.7);
            border-radius: 50%;
            pointer-events: none;
            z-index: 99998;
            transform: translate(-50%, -50%);
            transition: width 0.2s ease, height 0.2s ease, border-color 0.2s ease, transform 0.1s ease-out;
        }

        /* Hide Google Translate Bar */
        .goog-te-banner-frame, .skiptranslate, iframe.skiptranslate {
            display: none !important;
        }
        body {
            top: 0px !important;
        }

        /* Header Navigation */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 15px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border-color);
            transition: var(--transition-smooth);
        }

        .brand {
            font-family: var(--font-serif);
            font-size: 1.2rem;
            letter-spacing: 3px;
            color: var(--text-main);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition-smooth);
        }

        .brand span {
            color: var(--gold-accent);
        }

        .brand:hover {
            letter-spacing: 5px;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 20px;
            align-items: center;
        }

        nav a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.75rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-weight: 500;
            position: relative;
            padding-bottom: 4px;
            transition: var(--transition-smooth);
        }

        nav a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0%;
            height: 1px;
            background-color: var(--gold-accent);
            transition: var(--transition-smooth);
        }

        nav a:hover {
            color: var(--gold-accent);
        }

        nav a:hover::after {
            width: 100%;
        }

        /* LANGUAGE DROPDOWN */
        .custom-lang-dropdown {
            position: relative;
            display: inline-block;
        }

        .lang-drop-btn {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 8px 16px;
            font-family: var(--font-sans);
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 10px;
            border-radius: 4px;
            transition: var(--transition-smooth);
        }

        .lang-drop-btn:hover {
            border-color: var(--gold-accent);
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

        .arrow-icon {
            font-size: 0.65rem;
            color: var(--gold-accent);
            transition: transform 0.3s ease;
        }

        .custom-lang-dropdown.active .arrow-icon {
            transform: rotate(180deg);
        }

        .lang-menu-list {
            position: absolute;
            top: 110%;
            right: 0;
            width: 200px;
            background: #ffffff;
            border: 1px solid var(--border-color);
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            border-radius: 4px;
            display: none;
            flex-direction: column;
            z-index: 1005;
            overflow: hidden;
        }

        .custom-lang-dropdown.active .lang-menu-list {
            display: flex;
        }

        .lang-option {
            padding: 10px 15px;
            font-size: 0.8rem;
            color: var(--text-main);
            background: transparent;
            border: none;
            text-align: left;
            transition: var(--transition-smooth);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .lang-option:hover {
            background: var(--bg-card);
            color: var(--gold-accent);
            padding-left: 20px;
        }

        /* BOOKING BUTTON */
        .booking-time-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: var(--text-main);
            color: #ffffff;
            padding: 12px 24px;
            border: 1px solid var(--text-main);
            font-size: 0.75rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-weight: 500;
            text-decoration: none;
            border-radius: 3px;
            transition: var(--transition-smooth);
        }

        .booking-time-btn:hover {
            background: var(--gold-accent);
            border-color: var(--gold-accent);
            color: #ffffff;
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(184, 151, 82, 0.3);
        }

        .status-dot {
            width: 8px;
            height: 8px;
            background-color: #22c55e;
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 0 8px #22c55e;
        }

        /* HERO SECTION */
        .hero {
            min-height: 100vh;
            padding: 160px 6% 80px;
            display: flex;
            align-items: center;
            background: linear-gradient(180deg, #ffffff 0%, var(--bg-card) 100%);
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1fr 1.1fr;
            gap: 50px;
            align-items: center;
            max-width: 1300px;
            margin: 0 auto;
        }

        .cutout-wrapper {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: flex-end;
        }

        .cutout-wrapper::before {
            content: '';
            position: absolute;
            width: 80%;
            height: 80%;
            background: radial-gradient(circle, rgba(184, 151, 82, 0.08) 0%, rgba(255,255,255,0) 70%);
            z-index: 1;
            border-radius: 50%;
            transition: var(--transition-smooth);
        }

        .cutout-wrapper:hover::before {
            background: radial-gradient(circle, rgba(184, 151, 82, 0.2) 0%, rgba(255,255,255,0) 75%);
            transform: scale(1.1);
        }

        .cutout-portrait {
            width: 100%;
            max-width: 460px;
            height: auto;
            position: relative;
            z-index: 2;
            filter: drop-shadow(0px 20px 30px rgba(0, 0, 0, 0.08));
            display: block;
            transition: var(--transition-smooth);
        }

        .cutout-wrapper:hover .cutout-portrait {
            transform: translateY(-8px) scale(1.02);
            filter: drop-shadow(0px 30px 45px rgba(184, 151, 82, 0.25));
        }

        .tag-line {
            display: inline-block;
            font-size: 0.75rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--gold-accent);
            font-weight: 600;
            margin-bottom: 15px;
        }

        .main-title {
            font-family: var(--font-serif);
            font-size: 3.5rem;
            line-height: 1.1;
            margin-bottom: 20px;
            font-weight: 500;
        }

        .main-desc {
            color: var(--text-muted);
            font-size: 1rem;
            margin-bottom: 30px;
            font-weight: 300;
        }

        .specs-wrapper {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 15px;
            margin-bottom: 30px;
        }

        .spec-box {
            background: var(--bg-main);
            padding: 20px;
            border: 1px solid var(--border-color);
            border-top: 2px solid var(--gold-accent);
            transition: var(--transition-smooth);
        }

        .spec-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.06);
            border-color: var(--gold-accent);
        }

        .spec-lbl {
            font-size: 0.68rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 5px;
        }

        .spec-txt {
            font-size: 1rem;
            font-weight: 500;
            color: var(--text-main);
        }

        section {
            padding: 100px 6%;
            border-bottom: 1px solid var(--border-color);
        }

        .sec-head {
            margin-bottom: 50px;
        }

        .sec-tag {
            font-size: 0.75rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--gold-accent);
            font-weight: 600;
            margin-bottom: 10px;
        }

        .sec-heading {
            font-family: var(--font-serif);
            font-size: 2.6rem;
            font-weight: 400;
        }

        /* GENERAL GALLERY STYLES FOR SECTIONS */
        .section-gallery {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-top: 35px;
        }

        .gallery-img-box {
            position: relative;
            overflow: hidden;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            height: 240px;
            transition: var(--transition-smooth);
        }

        .gallery-img-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .gallery-img-box:hover img {
            transform: scale(1.08);
        }

        .gallery-img-box:hover {
            border-color: var(--gold-accent);
            box-shadow: 0 15px 30px rgba(184, 151, 82, 0.15);
        }

        /* BIO & CAREER */
        .bio-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
        }

        .bio-box {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 45px;
            transition: var(--transition-smooth);
        }

        .bio-box:hover {
            transform: translateY(-6px);
            background: var(--bg-main);
            border-color: var(--gold-accent);
            box-shadow: 0 20px 40px rgba(0,0,0,0.05);
        }

        .bio-box h3 {
            font-family: var(--font-serif);
            font-size: 1.8rem;
            margin-bottom: 20px;
        }

        .career-timeline {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .career-item {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 30px;
            display: grid;
            grid-template-columns: 150px 1fr;
            gap: 20px;
            transition: var(--transition-smooth);
        }

        .career-item:hover {
            transform: translateX(8px);
            background: var(--bg-main);
            border-color: var(--gold-accent);
            box-shadow: 0 15px 35px rgba(0,0,0,0.05);
        }

        .career-year {
            font-family: var(--font-serif);
            font-size: 1.2rem;
            color: var(--gold-accent);
            font-weight: 600;
        }

        /* GLOBAL CARDS */
        .global-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
        }

        .global-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 35px;
            transition: var(--transition-smooth);
        }

        .global-card:hover {
            transform: translateY(-8px);
            background: var(--bg-main);
            box-shadow: 0 20px 40px rgba(184, 151, 82, 0.12);
            border-color: var(--gold-accent);
        }

        .global-region {
            font-size: 0.75rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--gold-accent);
            margin-bottom: 10px;
            font-weight: 600;
        }

        .global-title {
            font-family: var(--font-serif);
            font-size: 1.4rem;
            margin-bottom: 12px;
        }

        /* PITCH CARD */
        .showcase-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 50px;
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 40px;
            align-items: center;
            transition: var(--transition-smooth);
        }

        .showcase-card:hover {
            box-shadow: 0 20px 45px rgba(0,0,0,0.06);
            border-color: var(--gold-accent);
        }

        .pitch-side-box {
            background: var(--bg-main);
            padding: 35px;
            border: 1px solid var(--border-color);
            text-align: center;
            transition: var(--transition-smooth);
        }

        .pitch-side-box:hover {
            transform: scale(1.03);
            border-color: var(--gold-accent);
        }

        /* HOLDINGS CARDS */
        .holdings-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 25px;
        }

        .holding-item {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 35px 25px;
            transition: var(--transition-smooth);
        }

        .holding-item:hover {
            transform: translateY(-6px);
            background: var(--bg-main);
            border-color: var(--gold-accent);
            box-shadow: 0 15px 35px rgba(0,0,0,0.05);
        }

        .holding-num {
            font-family: var(--font-serif);
            font-size: 1.4rem;
            color: var(--gold-accent);
            margin-bottom: 10px;
        }

        /* CONTACT SECTION */
        .contact-section-wrapper {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 40px;
            align-items: center;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 35px;
            transition: var(--transition-smooth);
        }

        .contact-section-wrapper:hover {
            box-shadow: 0 20px 45px rgba(0,0,0,0.05);
            border-color: var(--gold-accent);
        }

        .map-frame {
            width: 100%;
            height: 400px;
            border: 1px solid var(--border-color);
            filter: grayscale(80%) contrast(90%);
            transition: var(--transition-smooth);
        }

        .map-frame:hover {
            filter: grayscale(0%) contrast(100%);
        }

        .contact-item {
            margin-bottom: 25px;
            padding: 12px;
            border-radius: 4px;
            transition: var(--transition-smooth);
        }

        .contact-item:hover {
            background: var(--bg-main);
            transform: translateX(6px);
        }

        .contact-lbl {
            font-size: 0.7rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--gold-accent);
            font-weight: 600;
            margin-bottom: 6px;
        }

        .contact-val {
            font-size: 1.05rem;
            color: var(--text-main);
            font-weight: 500;
            word-break: break-all;
        }

        .contact-sub {
            font-size: 0.85rem;
            color: var(--text-muted);
            font-weight: 300;
        }

        footer {
            padding: 35px 6%;
            text-align: center;
            background: var(--bg-accent);
            font-size: 0.85rem;
            color: var(--text-muted);
            border-top: 1px solid var(--border-color);
        }

        @media (max-width: 1024px) {
            header {
                flex-direction: column;
                gap: 15px;
                padding: 15px 3%;
            }
            nav ul {
                flex-wrap: wrap;
                justify-content: center;
                gap: 12px;
            }
        }

        @media (max-width: 900px) {
            .hero-grid, .bio-grid, .showcase-card, .contact-section-wrapper, .career-item {
                grid-template-columns: 1fr;
            }
            .main-title {
                font-size: 2.5rem;
            }
        }
